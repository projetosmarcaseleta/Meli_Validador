[Unit]
Description=Meli Triagem - Motor de Exclusao e Triagem em Lote
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/Meli_Triagem
Environment="PATH=/var/www/Meli_Triagem/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/var/www/Meli_Triagem/.env
ExecStart=/var/www/Meli_Triagem/venv/bin/gunicorn --bind 0.0.0.0:3008 --workers 2 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
