# Token do Mercado Livre. Não commitar este arquivo.
MELI_ACCESS_TOKEN=

# Webhook n8n (produção) que devolve o token ML em api_key.
MELI_TOKEN_WEBHOOK_URL=https://api.marcaseleta.shop/webhook/646be4d7-0db5-42c3-96b4-654058ef7a79

# AnyMarket Backoffice (GET /products e /skus por SKU)
GUMGA_TOKEN=
ANYMARKET_PLATFORM=SELETA

# Webhook n8n SKU → MLB (workflow zAxE6ZpLgyLyFqu7)
ANYMARKET_SKU_WEBHOOK_URL=https://api.marcaseleta.shop/webhook/consultar-skus-anymarket

# Seletor de clientes. Cada extra usa CLIENT_<ID>_*.
# CLIENTS=seleta,magalu
# CLIENT_DEFAULT_ID=seleta
CLIENT_SELETA_NAME=Marca Seleta
CLIENT_SELETA_PLATFORM=SELETA
CLIENT_SELETA_SKU_WEBHOOK_URL=https://api.marcaseleta.shop/webhook/consultar-skus-anymarket
# CLIENT_MAGALU_NAME=Magazine Luiza
# CLIENT_MAGALU_PLATFORM=MAGALU
# CLIENT_MAGALU_GUMGA_TOKEN=
# CLIENT_MAGALU_SKU_WEBHOOK_URL=

# Réplica AnyMarket (SKU → MLB Catálogo/Tradicional)
ANYMARKET_DB_HOST=
ANYMARKET_DB_PORT=5432
ANYMARKET_DB_NAME=anymarket
ANYMARKET_DB_USER=
ANYMARKET_DB_PASSWORD=
ANYMARKET_DB_SSLMODE=require
ANYMARKET_OI=

# Google Apps Script webhook (opcional; também pode ser salvo no navegador).
GOOGLE_SHEET_WEBHOOK_URL=

# Support App AnyMarket (VPN). Nunca commitar o JWT.
ANYMARKET_SUPPORT_BASE_URL=http://support-app.anymarket.internal
ANYMARKET_SUPPORT_TOKEN=

# Backoffice v2 por OI (quando o token da support-app não autentica na API pública)
# ANYMARKET_GUMGA_OI_259063586=
# ANYMARKET_PLATFORM_OI_259063586=KABUM

# OpenAI — nunca commitar a chave. Rotacione se ela vazar.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_IMAGES_PER_SIDE=3
AI_PREVALIDATION_ENABLED=0
