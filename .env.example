# ============================================================
# Meli Validador - Variáveis de Ambiente (.env)
# ============================================================

# Porta e Execução do Servidor
PORT=3002
FLASK_DEBUG=0
SECRET_KEY=sua_chave_secreta_aqui
PUBLIC_URL=https://validador.marcaseleta.shop

# Webhook do n8n para Consulta de SKUs no AnyMarket (Recomendado para VPS)
ANYMARKET_SKU_WEBHOOK_URL=https://seu-n8n.com/webhook/consultar-skus-anymarket

# Configurações AnyMarket (API REST)
GUMGA_TOKEN=seu_gumga_token_aqui
ANYMARKET_PLATFORM=SELETA
ANYMARKET_API_BASE_URL=https://api.anymarket.com.br/v2

# Réplica de Leitura AnyMarket (Opcional - se houver conexão direta via VPN)
ANYMARKET_DB_HOST=
ANYMARKET_DB_PORT=5432
ANYMARKET_DB_NAME=anymarket
ANYMARKET_DB_USER=
ANYMARKET_DB_PASSWORD=
ANYMARKET_DB_SSLMODE=require
ANYMARKET_OI=

# Webhook do Google Apps Script / Planilha (Opcional)
GOOGLE_SHEET_WEBHOOK_URL=
