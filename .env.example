# ============================================================
# Meli Validador & Agrupador - Variáveis de Ambiente (.env)
# ============================================================

# Token do Mercado Livre (Bearer Token de aplicação)
MELI_ACCESS_TOKEN=

# Modo de Execução (true = simula plano sem enviar PUTs; false = aplica alterações)
DRY_RUN=true

# Segundos de espera para revalidação após PARENT_PK e family_name
REVALIDACAO_SEGUNDOS=45
REVALIDACAO_INTERVALO_SEGUNDOS=5

# Concorrência de requisições à API do Mercado Livre
MELI_CONCURRENCY=10

# Unidade de agrupamento:
# gender = agrupa por gênero (n8n)
# gender_brand_model = quebra lote por produto (padrão)
GROUPING_UNIT=gender_brand_model

# Réplica de leitura do AnyMarket (PostgreSQL - obrigatório quando a entrada tiver SKU)
ANYMARKET_DB_HOST=
ANYMARKET_DB_PORT=5432
ANYMARKET_DB_NAME=anymarket
ANYMARKET_DB_USER=
ANYMARKET_DB_PASSWORD=
ANYMARKET_DB_SSLMODE=require
ANYMARKET_OI=259062760.

# Porta do Servidor Web FastAPI (padrão 8765)
PORT=8765
