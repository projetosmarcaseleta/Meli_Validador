# Token do Mercado Livre. Não commitar este arquivo.
MELI_ACCESS_TOKEN=

# Réplica AnyMarket (SKU → MLB Catálogo/Tradicional)
ANYMARKET_DB_HOST=
ANYMARKET_DB_PORT=5432
ANYMARKET_DB_NAME=anymarket
ANYMARKET_DB_USER=
ANYMARKET_DB_PASSWORD=
ANYMARKET_DB_SSLMODE=require
ANYMARKET_OI=

# Google Apps Script webhook (opcional; também pode ser salvo no navegador).
GOOGLE_SHEET_WEBHOOK_URL=

# OpenAI — nunca commitar a chave. Rotacione se ela vazar.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_IMAGES_PER_SIDE=3
AI_PREVALIDATION_ENABLED=0
