[Unit]
Description=Meli Validador & Agrupador - Mercado Livre
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/Meli_Validador
Environment="PATH=/var/www/Meli_Validador/venv/bin:/usr/bin"
EnvironmentFile=/var/www/Meli_Validador/.env
ExecStart=/var/www/Meli_Validador/venv/bin/uvicorn agrupar.web:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
