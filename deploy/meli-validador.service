[Unit]
Description=Meli Validador - Auditoria de Anúncios Mercado Livre
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/Meli_Validador/ml_exporter
Environment="PATH=/var/www/Meli_Validador/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/var/www/Meli_Validador/.env
ExecStart=/var/www/Meli_Validador/venv/bin/gunicorn --bind 0.0.0.0:3002 --workers 2 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
